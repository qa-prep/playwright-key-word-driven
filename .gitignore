# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/playwright/node_modules/
/config/*
# ci.config is the one exception: no credentials belong in it, ever - just
# deterministic, non-secret CI values (fixed URLs/ports for a throwaway CI
# stack, behavioral settings like BROWSERS/SLACK_ENABLED). Real credentials
# still only ever live in config/<env>.env (gitignored) or CI secrets.
!/config/ci.config
.features-gen/
.DS_Store
/playwright.config.ts

tests_keyword_driven/projects/*
!tests_keyword_driven/projects/default
!tests_keyword_driven/projects/default/**
!tests_keyword_driven/projects/myProjectA
!tests_keyword_driven/projects/myProjectA/**
!tests_keyword_driven/projects/myProjectB
!tests_keyword_driven/projects/myProjectB/**