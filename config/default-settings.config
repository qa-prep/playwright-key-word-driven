# location: config/default-settings.config
# Canonical defaults, laid down by the installer. Safe to commit, no secrets.
# Override any of these for your own machine in config/default-settings.config
# config/* is gitignored.
#
# Every key here is "_"-prefixed and gets `set -a`-sourced into the
# environment the same way config/<env>.env is, so any of them can be read
# straight out of a feature file too, e.g. `When I spit "_DEBUG_MODE"` - see
# tests_keyword_driven/generic/support/envTokens.ts (it doesn't care which
# file a _TOKEN came from, only that it's exported when tests run).

# You can launch tests using /run-tests.sh project=myProjectA tags=@test, but if you dont define one this will be used:
_PROJECT=default

# Options: spec | feature | all
_TESTS_TYPE=feature

# Options: chrome | firefox | safari | mixed (all three) | comma-separated list, e.g. chrome,firefox
_BROWSERS=chrome

# Options: default (Playwright's own default, 1 less browser worker than the number of cores) | max (every logical core) | a positive whole number
_WORKERS=default

# Options: true | false
_HEADED=false

# Options: none (don't build) | never (build the report file, never open) | on-failure (build + open only on failure) | always (build + open regardless)
_REPORT_MODE=never

# Options: off | all | sql | steps
_DEBUG_MODE=off

# Options: fast (0ms, no artificial delay) | medium (250ms) | slow (750ms) | vslow (1500ms)
_SPEED=fast

# Options: true | false
_SCREENSHOT_ON_FAIL=true

# Options: true | false - post pass/fail results to Slack after a run
_SLACK_ENABLED=true

# Options: never | on-failure | always - when to actually send, if _SLACK_ENABLED=true
_SLACK_NOTIFY_MODE=always

# Options: true | false - if true, this will never slack when you run tests in debug mode
_SLACK_NEVER_IN_DEBUG=false

# Options: true | false - suppress run-tests.sh's own informational output
# (config summary, rerun hints, etc). Real errors and Playwright's own
# output are never suppressed.
_SILENT=false

# Options: true | false - opens Playwright's own step-by-step Inspector
# (npx playwright test --debug under the hood) instead of just running
# headed. Forces headed on its own, so headed= doesn't need to be set too.
_INSPECTOR=false

# Local dev loop only - point this at whatever's actually running on your
# machine. A CI environment overrides these with its own fixed values (see
# config/ci.config) rather than sharing this file.
_APP_URL=http://localhost:5173
_API_URL=http://localhost/api

# Optional ordered setup/teardown phases, run before/after the main test
# suite, e.g. an install flow that must complete before anything else can
# run. Empty or unset means skipped entirely, so this has no effect unless
# you use it. Add as many PRE_TEST_N / POST_TEST_N as you need, they run in
# numeric order, each one to completion before the next starts. A failed
# PRE_TEST_N stops the run before the main suite ever starts.
#
# PRE_TEST_1=tests_keyword_driven/projects/myProjectB/features/pre-tests
PRE_TEST_1=
PRE_TEST_2=
POST_TEST_1=
POST_TEST_2=
