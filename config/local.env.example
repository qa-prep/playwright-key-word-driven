# config/local.env

DB_HOST=localhost
DB_PORT=3316
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-pass

APP_URL=http://localhost:5173
API_URL=http://localhost/api

SETTINGS_FILE=config/default-settings.config


# https://api.slack.com/apps > "Create New App" > "Blank app" > "Name it" > "Bot Scope" > "chat:write, chat:write.public" > get OAuth
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
#right-click the channel in Slack, "View channel details", ID is at the bottom.
SLACK_CHANNEL=C0-your-channel-id-here