# location: config/ci.config
# Optional pattern for CI: everything in THIS file is safe to commit for real
# - no credentials, ever. Point config/<env>.env's _SETTINGS_FILE at this
# file (e.g. from a CI workflow step) to keep CI's non-secret values (fixed
# URLs/ports for a throwaway CI stack, behavioral settings) checked into the
# repo and readable in a normal diff, instead of buried in workflow YAML.
# Real credentials still only ever belong in config/<env>.env (gitignored)
# or your CI provider's own secrets store, injected into a small *generated*
# config/<env>.env at CI runtime instead (see .github/workflows for the
# pattern - generate just the secrets, then _SETTINGS_FILE=config/ci.config
# for everything else).

# Same options as config/default-settings.config
BROWSERS=chrome
WORKERS=default
HEADED=false
REPORT_MODE=never
DEBUG_MODE=off
SPEED=fast
SCREENSHOT_ON_FAIL=true
SLACK_ENABLED=true
SLACK_NOTIFY_MODE=always
SLACK_NEVER_IN_DEBUG=true

# Any _TOKEN your tests reference resolves from process.env regardless of
# which file exported it (env file or settings file both get `set -a` /
# `source`d the same way in run-tests.sh) - see
# tests_keyword_driven/generic/support/envTokens.ts. So non-secret _TOKENs
# are fine here too, e.g. fixed URLs for your CI-only stack:
# _APP_URL=http://localhost:8081
# _API_URL=http://localhost:8081/api
