# config/ci.env
# We dont commit env file, when the ci env runs ci/cd,
# we build this file using CI/CD pipeline secrets - see
# .github/workflows/tests.yml in dash-sites.
#
# update config/dash-sites-ci-secrets.json
# Then run: 
# gh secret set CI_SECRETS_JSON --repo botmike/dash-sites-ci < config/dash-sites-ci-secrets.json
# 
# Everything non-secret (DB/app URLs, browser/Slack settings, PRE_TEST_N)
# now lives in the committed config/ci-settings.config instead - this file
# only holds the pointer to it plus the actual credentials.

_SETTINGS_FILE=config/ci-settings.config

# https://api.slack.com/apps > "Create New App" > "Blank app" > "Name it" > "Bot Scope" > "chat:write" > get OAuth
_SLACK_BOT_TOKEN=xoxb-your-bot-token-here
#right-click the channel in Slack, "View channel details", ID is at the bottom.
_SLACK_CHANNEL=C0-your-channel-id-here

#User credentials for automation:
_AUTOMATION_API_USERNAME1=
_AUTOMATION_API_PASSWORD1=

_SUPER_ADMIN_USERNAME1=
_SUPER_ADMIN_PASSWORD1=

_AUTO_USER_EMAIL_DOMAIN='example.com'
