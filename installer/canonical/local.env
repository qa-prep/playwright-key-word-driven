# config/local.env

_DB_HOST=localhost
_DB_PORT=3316
_DB_NAME=backup_ds
_DB_USER=root
_DB_PASSWORD=root_password

# _APP_URL/_API_URL now live in config/default-settings.config instead - not
# secret, so there's no need for them to be in a gitignored env file.
_SETTINGS_FILE=config/default-settings.config

# https://api.slack.com/apps > "Create New App" > "Blank app" > "Name it" > "Bot Scope" > "chat:write" > get OAuth
_SLACK_BOT_TOKEN=xoxb-your-bot-token-here
#right-click the channel in Slack, "View channel details", ID is at the bottom.
_SLACK_CHANNEL=C0-your-channel-id-here




#User credentials for automation:
_AUTOMATION_API_USERNAME1=
_AUTOMATION_API_PASSWORD1=

_SUPER_ADMIN_USERNAME1=
_SUPER_ADMIN_PASSWORD1=