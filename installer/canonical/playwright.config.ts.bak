// location: /playwright.config.ts
import { defineConfig } from '@playwright/test';
import { defineBddConfig } from 'playwright-bdd';
import fs from 'fs';
import os from 'os';
import { stepsForProject } from './tests_keyword_driven/generic/support/buildSteps';

// Speed knob for headed/debug runs: inserts a delay before every Playwright
// action (click, fill, etc.), purely for human-watchable runs. Doesn't touch
// assertions/backoff waits already in the step library, only action timing.
//   fast   (default) -> 0ms
//   medium            -> 250ms
//   slow              -> 750ms
//   vslow             -> 1500ms
const SPEED_MS: Record<string, number> = { fast: 0, medium: 250, slow: 750, vslow: 1500 };
const SPEED = (process.env.SPEED ?? 'fast').trim().toLowerCase();
const slowMo = SPEED_MS[SPEED] ?? 0;



// run-tests.sh resolves "mixed" into the full comma-separated list before
// exporting BROWSERS, so this config only ever needs to understand a plain
// list of browser keys. Direct `npx playwright test` invocations (bypassing
// the script) fall back to chrome alone.
const BROWSER_DEFS = {
  chrome: 'chromium',
  firefox: 'firefox',
  safari: 'webkit',
} as const;
type BrowserKey = keyof typeof BROWSER_DEFS;
const ALL_BROWSER_KEYS = Object.keys(BROWSER_DEFS) as BrowserKey[];

function resolveBrowserKeys(): BrowserKey[] {
  const raw = (process.env.BROWSERS ?? 'chrome').trim().toLowerCase();
  const requested = raw.split(',').map((s) => s.trim()).filter(Boolean);
  const valid = requested.filter((k): k is BrowserKey => (ALL_BROWSER_KEYS as string[]).includes(k));
  return valid.length > 0 ? valid : ['chrome'];
}
const browserKeys = resolveBrowserKeys();

const REPORT_DIR = process.env.REPORT_DIR ?? 'playwright-report/adhoc';
const REPORT_OPEN = process.env.REPORT_OPEN ?? 'never';

// debug-mode runs add explicit "I wait" steps and step-through logging, which
// can add up past the default 30s per-test timeout on their own. Give debug
// runs more headroom.
const DEBUG_MODE = process.env.DEBUG_MODE ?? 'off';
const IS_DEBUG_RUN = DEBUG_MODE !== 'off';
const TEST_TIMEOUT = IS_DEBUG_RUN ? 120_000 : 30_000;

// Our Before/BeforeStep/AfterStep/After logging in stepLogger.ts already
// prints a full, correctly-ordered account of every scenario during debug
// runs, so during debug runs we skip Playwright's own console reporter
// entirely rather than have its output collide with ours. Full detail is
// still captured in the HTML report either way.
const consoleReporters: any[] = IS_DEBUG_RUN ? [['dot']] : [['list']];



// Our feature/scenario header tracking in stepLogger.ts uses module-level
// state that assumes tests run one at a time in a single process, so debug
// runs are always forced to a single worker regardless of what WORKERS is
// set to. Outside of debug runs, WORKERS controls concurrency:
//   "default" -> leave it to Playwright's own default (~half your cores
//                locally, 1 under CI detection)
//   "max"     -> use every logical CPU core reported by the OS
//   a number  -> that exact worker count
function resolveWorkers(): number | undefined {
  if (IS_DEBUG_RUN) return 1;
  const raw = (process.env.WORKERS ?? 'default').trim().toLowerCase();
  if (raw === 'default' || raw === '') return undefined;
  if (raw === 'max') return os.cpus().length;
  const parsed = Number(raw);
  return Number.isInteger(parsed) && parsed > 0 ? parsed : undefined;
}
const workers = resolveWorkers();

const SLACK_ENABLED = (process.env.SLACK_ENABLED ?? 'false').trim().toLowerCase() === 'true';

const reporters: any[] = [...consoleReporters];
if (REPORT_OPEN !== 'none') {
  reporters.push(['html', { outputFolder: REPORT_DIR, open: REPORT_OPEN === 'none' ? 'never' : REPORT_OPEN }]);
}
if (SLACK_ENABLED) {
  reporters.push(['json', { outputFile: `${REPORT_DIR}/results.json` }]);
}

/*
const reporters: any[] =
  REPORT_OPEN === 'none'
    ? consoleReporters
    : [
        ...consoleReporters,
        ['html', { outputFolder: REPORT_DIR, open: REPORT_OPEN === 'none' ? 'never' : REPORT_OPEN }],
      ];
*/

const specProjects = browserKeys.map((key) => ({
  name: `spec-${key}`,
  testDir: 'tests',
  use: { browserName: BROWSER_DEFS[key] },
}));

// --- feature (BDD) projects ---
//
// Only the requested PROJECT (plus its PRE_TEST_N/POST_TEST_N phases below)
// gets a defineBddConfig() call and a Playwright project, not every project
// folder in the repo - building the full matrix on every invocation was
// wasteful. run-tests.sh exports PROJECT before invoking Playwright/bddgen;
// a direct `npx playwright test` bypassing the script falls back to
// "default", matching run-tests.sh's own default. This also folds "default"
// into the same single code path as any other project, rather than a
// separate hardcoded case that used to collide with the auto-discovered
// "default" folder under the old full-matrix build.
const PROJECT = process.env.PROJECT ?? 'default';

// PRE_TEST_N / POST_TEST_N values (see config/default-settings.config):
//   no "/"  -> a project name, looked up under tests_keyword_driven/projects/<name>
//   has "/" -> a literal path from the repo root (leading "/" stripped)
// This lets one setup step (e.g. an install flow) live in one place and be
// shared across projects, instead of duplicated into every project that
// needs it.
function resolvePhasePath(value: string): string {
  const trimmed = value.trim();
  if (trimmed.includes('/')) {
    return trimmed.replace(/^\/+/, '');
  }
  const underProjects = `tests_keyword_driven/projects/${trimmed}`;
  return fs.existsSync(underProjects) ? underProjects : trimmed;
}

// Discovers PRE_TEST_1, PRE_TEST_2, ... (or POST_TEST_*) from the
// environment, in numeric order, skipping any that are unset/empty. No
// fixed limit: config/default-settings.config is sourced with `set -a`, so
// any PRE_TEST_N/POST_TEST_N a user adds is automatically visible here, no
// other changes needed anywhere.
function discoverPhases(prefix: 'PRE_TEST_' | 'POST_TEST_'): { num: number; path: string }[] {
  return Object.keys(process.env)
    .map((key) => {
      const match = key.match(new RegExp(`^${prefix}(\\d+)$`));
      return match ? { num: Number(match[1]), value: process.env[key] ?? '' } : null;
    })
    .filter((entry): entry is { num: number; value: string } => entry !== null && entry.value.trim() !== '')
    .sort((a, b) => a.num - b.num)
    .map(({ num, value }) => ({ num, path: resolvePhasePath(value) }));
}

// Phases always use the main PROJECT's steps (generic + that project's
// overrides), regardless of where the phase's .feature files physically
// live, since you're running them as part of that project's suite. Phases
// run against a single browser only, never once per browser - a setup step
// like "install the app" only needs to happen once, running it again in a
// second browser would just hit "already installed" and fail.
const primaryBrowser = browserKeys[0];

function buildPhaseProjects(kind: 'pre-test' | 'post-test', phases: { num: number; path: string }[]) {
  return phases.map(({ num, path: featurePath }) => ({
    name: `${kind}-${num}-${PROJECT}`,
    testDir: defineBddConfig({
      outputDir: `.features-gen/${PROJECT}-${kind}-${num}`,
      features: `${featurePath}/**/*.feature`,
      steps: stepsForProject(PROJECT),
    }),
    use: { browserName: BROWSER_DEFS[primaryBrowser] },
  }));
}

const preTestProjects = buildPhaseProjects('pre-test', discoverPhases('PRE_TEST_'));
const postTestProjects = buildPhaseProjects('post-test', discoverPhases('POST_TEST_'));

const mainBddConfig = defineBddConfig({
  outputDir: `.features-gen/${PROJECT}`,
  features: `tests_keyword_driven/projects/${PROJECT}/features/**/*.feature`,
  steps: stepsForProject(PROJECT),
});

const mainFeatureProjects = browserKeys.map((key) => ({
  name: `feature-${PROJECT}-${key}`,
  testDir: mainBddConfig,
  use: { browserName: BROWSER_DEFS[key] },
}));

const SCREENSHOT_ON_FAIL = (process.env.SCREENSHOT_ON_FAIL ?? 'true').trim().toLowerCase() !== 'false';


export default defineConfig({
  timeout: TEST_TIMEOUT,
  workers,
  use: {
    launchOptions: { slowMo },
    screenshot: SCREENSHOT_ON_FAIL ? 'only-on-failure' : 'off',
  },
  reporter: reporters,
  projects: [
    ...specProjects,
    ...preTestProjects,
    ...mainFeatureProjects,
    ...postTestProjects,
  ],
});