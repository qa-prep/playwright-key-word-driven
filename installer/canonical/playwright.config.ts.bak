// location: /playwright.config.ts
import { defineConfig } from '@playwright/test';
import { defineBddConfig } from 'playwright-bdd';
import fg from 'fast-glob';
import path from 'path';
import { stepsForProject } from './keyword_driven/generic/support/buildSteps';

const projectNames = fg.sync('keyword_driven/projects/*', { onlyDirectories: true })
  .map((dir) => path.basename(dir));

const bddConfigs = Object.fromEntries(
  projectNames.map((name) => [
    name,
    defineBddConfig({
      outputDir: `.features-gen/${name}`,
      features: `keyword_driven/projects/${name}/features/**/*.feature`,
      steps: stepsForProject(name),
    }),
  ]),
);

const defaultBdd = defineBddConfig({
  outputDir: '.features-gen/default',
  features: 'keyword_driven/projects/default/features/**/*.feature',
  steps: stepsForProject('default'),
});

const REPORT_DIR = process.env.REPORT_DIR ?? 'playwright-report/adhoc';
const REPORT_OPEN = process.env.REPORT_OPEN ?? 'never';

// debug-mode runs add explicit "I wait" steps and step-through logging, which
// can add up past the default 30s per-test timeout on their own. Give debug
// runs more headroom.
const DEBUG_MODE = process.env.DEBUG_MODE ?? 'off';
const IS_DEBUG_RUN = DEBUG_MODE !== 'off';
const TEST_TIMEOUT = IS_DEBUG_RUN ? 120_000 : 30_000;

// Our Before/BeforeStep/AfterStep/After logging in stepLogger.ts already
// prints a full, correctly-ordered account of every scenario during debug
// runs. Playwright's built-in console reporters ('list', 'dot', etc.) all
// write their own progress output to stdout too, and since 'dot' writes bare
// '.'/'F' characters with no newline of their own, they land wherever the
// cursor happens to be and visually collide with our banners. So during
// debug runs, skip the console reporter entirely, our own logging is the
// console output. Full detail is still captured in the HTML report either
// way.
const consoleReporters: any[] = IS_DEBUG_RUN ? [] : [['list']];

// Our feature/scenario header tracking in stepLogger.ts uses module-level
// state that assumes tests run one at a time in a single process. With
// multiple workers, each worker's console output would interleave and the
// feature/scenario grouping would look scrambled even though each worker's
// own logic is correct. Force serial execution for debug runs.
const workers = IS_DEBUG_RUN ? 1 : undefined;

const reporters: any[] =
  REPORT_OPEN === 'none'
    ? consoleReporters
    : [
        ...consoleReporters,
        ['html', { outputFolder: REPORT_DIR, open: REPORT_OPEN === 'none' ? 'never' : REPORT_OPEN }],
      ];

export default defineConfig({
  timeout: TEST_TIMEOUT,
  workers,
  reporter: reporters,
  projects: [
    { name: 'spec-chromium', testDir: 'tests', use: { browserName: 'chromium' } },
    { name: 'spec-firefox', testDir: 'tests', use: { browserName: 'firefox' } },
    { name: 'feature-default', testDir: defaultBdd, use: { browserName: 'chromium' } },
    ...projectNames.map((name) => ({
      name: `feature-${name}`,
      testDir: bddConfigs[name],
      use: { browserName: 'chromium' as const },
    })),
  ],
});