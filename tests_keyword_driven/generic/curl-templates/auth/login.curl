# location: tests_keyword_driven/generic/curl-templates/auth/login.curl
# _API_URL _AUTOMATION_API_USERNAME  _AUTOMATION_API_PASSWORD  will be defined in your env file

curl --url '_API_URL/login' \
  -H 'Content-Type: application/json' \
  -H 'Accept: application/json' \
  --data-raw '{"login":"_AUTOMATION_API_USERNAME","password":"_AUTOMATION_API_PASSWORD","remember":false}'