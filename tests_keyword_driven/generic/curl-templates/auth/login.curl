# location: tests_keyword_driven/generic/curl-templates/auth/login.curl
# _API_URL will be defined in your env file. +var(login) +var(password) are
# supplied by whatever caller uses this template - getAutomationUserCurlContext()
# passes the automation account's credentials, but any login/password can be
# used (e.g. a super admin session for something the automation account
# can't do).

curl --url '_API_URL/login' \
  -H 'Content-Type: application/json' \
  -H 'Accept: application/json' \
  --data-raw '{"login":"+var(login)","password":"+var(password)","remember":false}'
